    },
    {
      "workflow_id": "vacuum",
      "command": "python3 examples/walkthrough.py --workflow vacuum"
    },
    {
      "workflow_id": "transaction-close",
      "command": "python3 examples/walkthrough.py --workflow transaction-close"
    },
    {
      "workflow_id": "statistics",
      "command": "python3 examples/walkthrough.py --workflow statistics"
    },
    {
      "workflow_id": "partial-publish",
      "command": "python3 examples/walkthrough.py --workflow partial-publish"
    },
    {
      "workflow_id": "partial-recovery",
      "command": "python3 examples/walkthrough.py --workflow partial-recovery"
    }
  ]
